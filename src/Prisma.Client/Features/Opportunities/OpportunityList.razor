@page "/diagnoses/{DiagnosisId:guid}/opportunities"
@using System.Net
@using System.Net.Http.Json
@using Prisma.Contracts.Bottlenecks
@using Prisma.Contracts.Diagnoses
@using Prisma.Contracts.Opportunities
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>@(_diagnosis?.Title ?? "Oportunidades") | Diagnóstico</PageTitle>

<section class="diagnosis-page opportunity-page">
    <div class="diagnosis-breadcrumbs">
        <NavLink href="/">Início</NavLink>
        <span aria-hidden="true">/</span>
        @if (_diagnosis is not null)
        {
            <NavLink href="@($"/diagnoses/{_diagnosis.Id}")">@_diagnosis.Title</NavLink>
            <span aria-hidden="true">/</span>
            <NavLink href="@($"/diagnoses/{_diagnosis.Id}/bottlenecks")">Gargalos</NavLink>
        }
        <span aria-hidden="true">/</span>
        <span>Oportunidades</span>
    </div>

    @if (_isLoading)
    {
        <div class="state-message card diagnosis-state" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Carregando oportunidades…</span>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="state-message state-error card diagnosis-state" role="alert">
            <p>@_loadError</p>
            <button class="btn btn-outline-primary" type="button" @onclick="LoadAsync">Tentar novamente</button>
        </div>
    }
    else if (_diagnosis is not null)
    {
        <header class="diagnosis-page-header opportunity-page-header">
            <div>
                <p class="eyebrow">PRIORIZAÇÃO</p>
                <h1>Oportunidades</h1>
                <p class="section-description">@_diagnosis.Title · @_diagnosis.ClientName</p>
            </div>
            <div class="opportunity-header-actions">
                <span class="status-pill status-@_diagnosis.Status">@GetStatusLabel(_diagnosis.Status)</span>
                @if (!IsReadOnly && _bottlenecks.Count > 0)
                {
                    <NavLink class="btn btn-primary" href="@($"/diagnoses/{DiagnosisId}/opportunities/new")">Cadastrar oportunidade</NavLink>
                }
            </div>
        </header>

        @if (IsReadOnly)
        {
            <div class="alert alert-info" role="status">
                Este diagnóstico está concluído e é somente leitura. Reabra-o para alterar as oportunidades.
            </div>
        }
        @if (_deleteError is not null)
        {
            <div class="alert alert-danger" role="alert">@_deleteError</div>
        }
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert alert-success" role="status">@_statusMessage</div>
        }

        <aside class="opportunity-score-explainer" aria-label="Como a prioridade é calculada">
            <span class="opportunity-score-symbol" aria-hidden="true">∑</span>
            <div>
                <strong>Prioridade como apoio à decisão</strong>
                <p>A pontuação é calculada por <code>(impacto × 2) + urgência − esforço</code>. A lista também considera impacto, menor esforço e título nos desempates. Use o resultado como referência para a conversa, não como decisão automática.</p>
            </div>
        </aside>

        @if (_bottlenecks.Count == 0)
        {
            <div class="state-message card opportunity-empty-state">
                <strong>Registre um gargalo antes de cadastrar oportunidades</strong>
                <span>Cada oportunidade deve estar relacionada a pelo menos um gargalo deste diagnóstico.</span>
                <NavLink class="btn btn-outline-primary" href="@($"/diagnoses/{DiagnosisId}/bottlenecks")">Ir para gargalos</NavLink>
            </div>
        }
        else if (_opportunities.Count == 0)
        {
            <div class="state-message card opportunity-empty-state">
                <span class="opportunity-empty-icon" aria-hidden="true">↗</span>
                <strong>Nenhuma oportunidade cadastrada</strong>
                <span>Relacione uma ou mais possibilidades de melhoria aos gargalos observados.</span>
                @if (!IsReadOnly)
                {
                    <NavLink class="btn btn-primary" href="@($"/diagnoses/{DiagnosisId}/opportunities/new")">Cadastrar primeira oportunidade</NavLink>
                }
            </div>
        }
        else
        {
            <section class="opportunity-list-card card" aria-labelledby="opportunity-list-heading">
                <div class="opportunity-list-heading">
                    <div>
                        <p class="eyebrow">ORDEM DE PRIORIDADE</p>
                        <h2 id="opportunity-list-heading">Oportunidades cadastradas (@_opportunities.Count)</h2>
                    </div>
                    <NavLink class="btn btn-sm btn-outline-secondary" href="@($"/diagnoses/{DiagnosisId}/bottlenecks")">Ver gargalos</NavLink>
                </div>

                <div class="opportunity-list">
                    @for (var index = 0; index < _opportunities.Count; index++)
                    {
                        var opportunity = _opportunities[index];
                        <article class="opportunity-item" @key="opportunity.Id">
                            <span class="opportunity-rank" aria-label="Posição @(index + 1)">@(index + 1)</span>
                            <div class="opportunity-item-main">
                                <div class="opportunity-item-title-row">
                                    <h3>@opportunity.Title</h3>
                                    <span class="opportunity-priority">Prioridade @opportunity.PriorityScore</span>
                                </div>
                                <p class="opportunity-meta">
                                    <span>@GetTypeLabel(opportunity.Type)</span>
                                    <span aria-hidden="true">·</span>
                                    <span>Impacto @opportunity.Impact</span>
                                    <span aria-hidden="true">·</span>
                                    <span>Esforço @opportunity.Effort</span>
                                    <span aria-hidden="true">·</span>
                                    <span>Urgência @opportunity.Urgency</span>
                                </p>
                                <p class="opportunity-benefit"><strong>Benefício esperado:</strong> @opportunity.ExpectedBenefit</p>
                                @if (!string.IsNullOrWhiteSpace(opportunity.SolutionDescription))
                                {
                                    <p class="opportunity-description">@opportunity.SolutionDescription</p>
                                }
                                <div class="opportunity-linked-bottlenecks" aria-label="Gargalos associados">
                                    @foreach (var bottleneckId in opportunity.BottleneckIds)
                                    {
                                        <span class="opportunity-link-chip" @key="bottleneckId">@GetBottleneckTitle(bottleneckId)</span>
                                    }
                                </div>
                                @if (opportunity.Type == "AiApplication" &&
                                     (!string.IsNullOrWhiteSpace(opportunity.AiDataNeeds) || opportunity.NeedsHumanReview.HasValue))
                                {
                                    <div class="opportunity-ai-note">
                                        <strong>Informações de apoio para uma aplicação de IA</strong>
                                        @if (!string.IsNullOrWhiteSpace(opportunity.AiDataNeeds))
                                        {
                                            <span>Dados necessários: @opportunity.AiDataNeeds</span>
                                        }
                                        @if (opportunity.NeedsHumanReview.HasValue)
                                        {
                                            <span>Revisão humana: @(opportunity.NeedsHumanReview.Value ? "necessária" : "não indicada")</span>
                                        }
                                    </div>
                                }
                            </div>
                            @if (!IsReadOnly)
                            {
                                <div class="opportunity-item-actions">
                                    <NavLink class="btn btn-sm btn-outline-primary"
                                             href="@($"/diagnoses/{DiagnosisId}/opportunities/{opportunity.Id}/edit")">Editar</NavLink>
                                    <button class="btn btn-sm btn-outline-danger" type="button"
                                            disabled="@(_deletingId.HasValue)" @onclick="() => DeleteAsync(opportunity)">
                                        @(_deletingId == opportunity.Id ? "Excluindo…" : "Excluir")
                                    </button>
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    }
</section>

@code {
    private static readonly IReadOnlyDictionary<string, string> TypeLabels = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["ProcessImprovement"] = "Melhoria de processo",
        ["ExistingTool"] = "Ferramenta existente",
        ["Integration"] = "Integração",
        ["CustomSoftware"] = "Software sob medida",
        ["Automation"] = "Automação",
        ["AiApplication"] = "Aplicação de IA"
    };

    [Parameter] public Guid DiagnosisId { get; set; }

    private DiagnosisContract? _diagnosis;
    private List<BottleneckContract> _bottlenecks = [];
    private List<OpportunityContract> _opportunities = [];
    private string? _loadError;
    private string? _deleteError;
    private string? _statusMessage;
    private Guid? _deletingId;
    private bool _isLoading;

    private bool IsReadOnly => _diagnosis?.Status == "Completed";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        _deleteError = null;
        _statusMessage = null;
        _diagnosis = null;
        _bottlenecks = [];
        _opportunities = [];
        try
        {
            using var diagnosisResponse = await Http.GetAsync($"api/diagnoses/{DiagnosisId}");
            if (diagnosisResponse.StatusCode == HttpStatusCode.NotFound)
            {
                _loadError = "O diagnóstico não foi encontrado.";
                return;
            }

            if (!diagnosisResponse.IsSuccessStatusCode)
            {
                _loadError = "Não foi possível carregar o diagnóstico. Tente novamente.";
                return;
            }

            _diagnosis = await diagnosisResponse.Content.ReadFromJsonAsync<DiagnosisContract>();
            if (_diagnosis is null)
            {
                _loadError = "A API não retornou os dados do diagnóstico.";
                return;
            }

            using var bottleneckResponse = await Http.GetAsync($"api/diagnoses/{DiagnosisId}/bottlenecks");
            using var opportunityResponse = await Http.GetAsync($"api/diagnoses/{DiagnosisId}/opportunities");
            if (!bottleneckResponse.IsSuccessStatusCode || !opportunityResponse.IsSuccessStatusCode)
            {
                _loadError = "Não foi possível carregar as oportunidades. Tente novamente.";
                return;
            }

            _bottlenecks = await bottleneckResponse.Content.ReadFromJsonAsync<List<BottleneckContract>>() ?? [];
            _opportunities = await opportunityResponse.Content.ReadFromJsonAsync<List<OpportunityContract>>() ?? [];
        }
        catch (HttpRequestException)
        {
            _loadError = "Não foi possível conectar à API. Verifique o serviço e tente novamente.";
        }
        catch (System.Text.Json.JsonException)
        {
            _loadError = "A resposta da API não pôde ser lida. Tente novamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteAsync(OpportunityContract opportunity)
    {
        if (IsReadOnly || _deletingId.HasValue)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Excluir a oportunidade ‘{opportunity.Title}’? Esta ação não pode ser desfeita.");
        if (!confirmed)
        {
            return;
        }

        _deletingId = opportunity.Id;
        _deleteError = null;
        _statusMessage = null;
        try
        {
            using var response = await Http.DeleteAsync($"api/diagnoses/{DiagnosisId}/opportunities/{opportunity.Id}");
            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                _deleteError = "Não foi possível excluir a oportunidade. Reabra o diagnóstico e tente novamente.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _deleteError = "A oportunidade não foi encontrada. Atualize a lista antes de tentar novamente.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _deleteError = "Não foi possível excluir a oportunidade. Tente novamente.";
                return;
            }

            _opportunities.RemoveAll(item => item.Id == opportunity.Id);
            _statusMessage = "Oportunidade excluída.";
        }
        catch (HttpRequestException)
        {
            _deleteError = "Não foi possível conectar à API. A exclusão não foi confirmada.";
        }
        catch (TaskCanceledException)
        {
            _deleteError = "A exclusão não foi confirmada. Atualize a lista antes de tentar novamente.";
        }
        finally
        {
            _deletingId = null;
        }
    }

    private string GetBottleneckTitle(Guid id) =>
        _bottlenecks.FirstOrDefault(bottleneck => bottleneck.Id == id)?.Title ?? "Gargalo";

    private static string GetTypeLabel(string type) => TypeLabels.GetValueOrDefault(type, "Tipo indisponível");

    private static string GetStatusLabel(string status) => status switch
    {
        "Draft" => "Rascunho",
        "InProgress" => "Em andamento",
        "Completed" => "Concluído",
        _ => "Status indisponível"
    };
}
